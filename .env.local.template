# ══════════════════════════════════════════════════════════════
# Capital OS — Environment Variables
# Copy this to .env.local and fill in your values
# ══════════════════════════════════════════════════════════════

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3456
NODE_ENV=development

# ── Supabase (Auth only — no data storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ── Convex (Application layer + Investor data) ──
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
CONVEX_DEPLOY_KEY=dev:YOUR_DEPLOYMENT|YOUR_KEY

# ── CockroachDB (Legacy — data migrating to Convex) ──
DATABASE_URL=postgresql://USER:PASS@HOST:26257/defaultdb?sslmode=verify-full

# ── Admin ──
COCKROACH_ADMIN_EMAILS=your@email.com

# ── Apollo API ──
APOLLO_API_KEY=YOUR_APOLLO_KEY

# ── AI (NVIDIA) ──
NVIDIA_API_KEY_1=
AI_MOCK_MODE=true

# ── Security ──
ALLOWED_ORIGINS=http://localhost:3456,https://your-domain.vercel.app
