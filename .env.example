# ===========================================
# Capital-OS Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# NVIDIA AI
# ===========================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ===========================================
# App
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3456

# ===========================================
# AI Configuration
# ===========================================
# Set to "true" to use mock AI responses (no API calls)
AI_MOCK_MODE=true

# ===========================================
# Email Provider (Phase 6)
# ===========================================
# EMAIL_PROVIDER_CLIENT_ID=
# EMAIL_PROVIDER_CLIENT_SECRET=

# ===========================================
# Feature Flags (Phase 10)
# ===========================================
# EDGE_CONFIG_ID=
# EDGE_CONFIG_READ_ONLY_KEY=
