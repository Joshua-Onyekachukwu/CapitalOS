{
  "$comment": "SEC SIC description → sector tag mapping. First-match-wins, ordered most-specific first. Tags are lowercase snake_case, aligned with the seed-sectors vocabulary where applicable; the rest are honest verticals that vocabulary lacks. 'unmapped' patterns intentionally yield NO tags: holding shells, IP lessors and government issuers have no honest sector — unknown stays unknown (evidence-backed pipeline contract). Consumed by src/lib/services/investor/sic-sectors.ts and scripts/backfill-sic-sectors.cjs.",
  "unmapped": {
    "$comment": "Matched first. No tags are written for these — they are not industry sectors.",
    "patterns": [
      "non-operating establishments",
      "patent owners",
      "foreign government",
      "holding companies"
    ]
  },
  "rules": [
    {
      "$comment": "Specific descriptions that would otherwise be swallowed by a generic pattern below",
      "patterns": [
        "radio & tv broadcasting & communications equipment",
        "hospital & medical service plans",
        "investors, nec",
        "oil & gas field machinery",
        "asset-backed securities",
        "security & commodity brokers",
        "telephone communications"
      ],
      "tagsFor": {
        "radio & tv broadcasting & communications equipment": ["hardware"],
        "hospital & medical service plans": ["insurance"],
        "investors, nec": ["real_estate"],
        "oil & gas field machinery": ["energy"],
        "asset-backed securities": ["capital_markets"],
        "security & commodity brokers": ["capital_markets"],
        "telephone communications": ["telecom"]
      }
    },
    { "patterns": ["commercial bank", "savings institution", "bank, nec", "credit union"], "tags": ["commercial_banking"] },
    { "patterns": ["insurance", "surety"], "tags": ["insurance"] },
    { "patterns": ["investment advice", "investment counsel", "asset management", "portfolio management"], "tags": ["asset_management"] },
    { "patterns": ["brokers", "dealer", "flotation", "depositary receipts", "exchanges & services"], "tags": ["capital_markets"] },
    { "patterns": ["finance services", "credit institution", "credit corporation", "business credit"], "tags": ["financial_services"] },
